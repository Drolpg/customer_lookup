# Opcional: o `docker compose up` funciona sem .env. Copie para .env só para sobrescrever algum valor.
# Nunca coloque credenciais reais em arquivos versionados.

# --- Banco e Redis (usados pelo compose para montar DATABASE_URL e REDIS_URL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=consultas
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/consultas
# REDIS_URL=redis://redis:6379/0

# --- API ---
API_KEY=chave-local-de-desenvolvimento
API_PORT=8000
RATE_LIMIT_POR_MINUTO=60
DOCUMENTO_VALIDAR_DV=true
LOG_LEVEL=INFO

# --- Serviço externo ---
# EXTERNO_URL=http://externo:9000
EXTERNO_TIMEOUT_CONEXAO_S=2
EXTERNO_TIMEOUT_LEITURA_S=3

# --- Retry (no compose o padrão é curto, para demonstração; no código: base 2 s, teto 60 s) ---
RETRY_MAX_TENTATIVAS=5
RETRY_BASE_SEGUNDOS=1
RETRY_TETO_SEGUNDOS=10

# --- Worker ---
WORKER_CONCORRENCIA=2
TAREFA_RATE_LIMIT=10/s

# --- API externa fake ---
FAKE_PORT=9000
FAKE_FALHAS_ANTES_DE_RECUPERAR=2
FAKE_LENTIDAO_SEGUNDOS=5
